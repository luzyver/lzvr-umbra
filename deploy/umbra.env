# Pengaturan Umbra. Setelah mengubah: systemctl restart umbra

# Alamat web panel. Bawaan hanya bisa dibuka dari server sendiri:
# pakai nginx (HTTPS) di depannya, atau SSH tunnel:
#   ssh -L 8080:127.0.0.1:8080 user@server  lalu buka http://localhost:8080
UMBRA_LISTEN=127.0.0.1:8080

# Cookie login hanya dikirim lewat HTTPS. Set false HANYA bila panel dibuka
# lewat http biasa (mis. dari jaringan VPN sendiri / SSH tunnel).
UMBRA_SECURE_COOKIE=true

# Set true bila panel berada di belakang nginx/Caddy (IP asli dari X-Real-IP).
UMBRA_TRUST_PROXY=false

# Integrasi AdGuard Home (kosongkan URL untuk mematikan).
# UMBRA_ADGUARD_URL=http://127.0.0.1:3000
# UMBRA_ADGUARD_USER=admin
# UMBRA_ADGUARD_PASS=
