# Umbra configuration. After changing it: systemctl restart umbra

# Panel web address. The default is reachable from the server itself only:
# put nginx (HTTPS) in front of it, or use an SSH tunnel:
#   ssh -L 8967:127.0.0.1:8967 user@server  then open http://localhost:8967
UMBRA_LISTEN=127.0.0.1:8967

# The login cookie is sent over HTTPS only. Set false ONLY when the panel is
# opened over plain http (e.g. from your own VPN network / an SSH tunnel).
UMBRA_SECURE_COOKIE=true

# Set true when the panel is behind nginx/Caddy (real IP from X-Real-IP).
UMBRA_TRUST_PROXY=false

# auto: try the kernel, then wireguard-go if the kernel lacks WireGuard.
# Other choices: kernel or userspace. Userspace needs /dev/net/tun.
UMBRA_WG_BACKEND=auto

# AdGuard Home. Easiest to install & connect from the AdGuard menu in the panel
# (stored in the database, no restart). The values below are only a fallback
# when no connection has been set in the panel.
# Install automatically once WireGuard is set up (set by install.sh --with-adguard):
# UMBRA_ADGUARD_AUTOINSTALL=false
# UMBRA_ADGUARD_URL=http://127.0.0.1:3000
# UMBRA_ADGUARD_USER=admin
# UMBRA_ADGUARD_PASS=
