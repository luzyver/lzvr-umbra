[Unit]
Description=Umbra - WireGuard manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=umbra
Group=umbra
EnvironmentFile=-/etc/umbra/umbra.env
ExecStart=/usr/local/bin/umbra
Restart=on-failure
RestartSec=3

# Network administration rights only (WireGuard via netlink + nftables), not full root.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true

StateDirectory=umbra
StateDirectoryMode=0700
RuntimeDirectory=wireguard
RuntimeDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
# Only the host TUN device is exposed in the private /dev, for wireguard-go.
BindPaths=-/dev/net/tun
DeviceAllow=/dev/net/tun rw
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
